{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "vercel-dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/shop", "destination": "/" },
    { "source": "/tyres/:path*", "destination": "/" },
    { "source": "/cart", "destination": "/" },
    { "source": "/checkout", "destination": "/" },
    { "source": "/services", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/delivery-returns", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/terms", "destination": "/" }
  ]
}
